###======================EXPERIEMNTIELLE ANZEIGE============================###

            ( WIRD EINGEPFLEGT BEI EINFÜHRUNG DER BIBLIOTHEK)

###====================REGULÄRE LINUX BASH SHELL============================###

 # INFORMATIONSBEREICH VOR DEM INSTALL NACH DEM DOWNLOAD :
 
cat PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/SETUP/INSTALL/info.install-notes

 # ERSTER INSTALLER WEG 

sudo pacman -S git 
git clone https://github.com/Pylovara/PYLOVARA-SYSTEM.git
cd PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/SETUP/INSTALL
sudo ./full.install-core

 # REINSTALL | UPDATE | EGAL VON WO 

SHELLUPDATE

 # UPDATE INFO KANN AUSGESCHALTET WERDEN IN DER SHELL.CONF AUF ZEILE 87.
 # WIR DIKTIEREN NICHTS, BIETEN ES ABER AN.
 # NICHT AKTUELLE SYSTEME, SIND VOLLSTÄNDIG VON SICHERHEITSUPDATES 
 # WIE AUCH RICHTIGKEIT DER DATEN - AUSGESCHLOSSEN.

###=================FREIWILLIGE BETA TESTER MCS BASH SHELL==================###

 # DIESER BEREICH IST NUR FÜR FREIWILLIGE BETA TESTER
 # BETA TEST MCS SHELL INTEGRATION (OHNE INTERPRETER, NIMMT WAS DA IST)

cd ARBEITERBIENEN/MCS-SHELL
./SETUP/mcs-shell.install-core

 # NACH DEM KLONEN AUSFÜHREN, ISSUES BEI BUG.

