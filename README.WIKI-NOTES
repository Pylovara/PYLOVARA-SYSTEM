 # REPO NUTZUNGS ART      : GESAMT SYSTEM | PYLOVARA-NETZWERK-SYSTEM 
 #
 #        „ALLE RECHTE DIESES REPOS GEHEN VON DEN GLOBALEN LIZENZEN AUS.“
 #
 #  /PYLOVARA-SYSTEM/LIZENZEN-GLOBAL/ ⠆⢄⢐⠤ GLOBALE LIZENZ REGELUNG 
 #
 #  /PYLOVARA-SYSTEM/ARBEITERBIENEN/ ⠆⢄⢐⡁ DRITTANBIETER LIZENZ REGELUNG 
 #
 # FÜR DRITTANBIETER SPRACHEN WURDE DER BEREICH ARBEITERBIENEN ERSTELLT 
 # UND BEHERBERGEN SCHNITTSTELLEN ZU ISA SPEZIFISCHE PROGRAMM ANSTEUERUNGEN
 # UND HABEN FREMDSPRACHEN ALS BRÜCKE INCLUDIERT .
 #
 # DER TEIL MIT DER SHELL BASIERTEN LEXIKON ANSTEUERUNG FÜR LINUX KERNEL 
 # UNTER BASH, IST TEIL VON DIESEM SEKTOR .
 #
 # SHELL CMD FÜR NAVI 
 # - kernel lex 
 # - mcs lex
 # - waben lex
 # - to /PYLOVARA-SYSTEM/
 # 
 # SHELL LAYOUTS KÖNNEN UNTER :
 # sudo nano /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/SHELL.CONF
 # GEÄNDERT WERDEN.
 # DIE SHELL LAYOUTS SIND OHNE BAUMODUS DESIGNE.
 #
###============================LINUX BASH SHELL=============================###

 # INFORMATIONSBEREICH VOR DEM INSTALL NACH DEM DOWNLOAD :
 
cat PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/SETUP/INSTALL/info.install-notes

 # ERSTER INSTALLER WEG 

sudo pacman -S git 
git clone https://github.com/Pylovara/PYLOVARA-SYSTEM.git
cd PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/SETUP/INSTALL
sudo ./full.install-core

 # REINSTALL | UPDATE | EGAL VON WO 

 

