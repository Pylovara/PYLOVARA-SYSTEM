#!/bin/bash
# UPDATESUCHER.PYLOVARA-CORE
# ===================================================================== #
# INFO    : Prüft ob für das Pylovara Shell ein Update verfügbar ist .
#           Vergleicht den lokalen Repo Stand mit dem Remote Stand .
#           alle 2 tage wird der check wiederholt .
# VERSION : 0.1
# ===================================================================== #
# HINWEIS : Es gibt keine Versionen . Es gibt immer nur die eine aktuelle .
#           Ein Update ist das erneute Laden des aktuellen Stands .
#           Das reguläre Update ist SHELLUPDATE .
# ===================================================================== #
# NOTIZ : KOMMT NUR ALLE 2 TAGE ... VIELLEICHT ERHÖHE ICH DIE ZEIT 
#         ABER ERST WENN ES RUHIGER WIRD .... MOMENTAN ZUVIELE ÄNDERUNGEN 
# ===================================================================== #

PV_REPO="/PYLOVARA-SYSTEM"
PV_REMOTE="https://github.com/Pylovara/PYLOVARA-SYSTEM.git"
PV_CHECK="/PYLOVARA-SYSTEM/.last_check"
PV_TWO_DAYS=172800

PV_NOW=$(date +%s)
PV_LAST="0"

if [ -f "$PV_CHECK" ]; then
  PV_LAST=$(cat "$PV_CHECK" 2>/dev/null)
fi

PV_VERGANGEN=0
if [ -n "$PV_LAST" ]; then
  PV_VERGANGEN=$(( PV_NOW - PV_LAST ))
fi

if [ "$PV_VERGANGEN" -lt "$PV_TWO_DAYS" ]; then
  exit 0
fi

PV_LOCAL=$(git -C "$PV_REPO" rev-parse HEAD 2>/dev/null)
PV_REMOTE_SHA=$(git ls-remote "$PV_REMOTE" HEAD 2>/dev/null | awk '{print $1}')

echo "$PV_NOW" > "$PV_CHECK"

if [ -n "$PV_LOCAL" ] && [ -n "$PV_REMOTE_SHA" ] && [ "$PV_LOCAL" != "$PV_REMOTE_SHA" ]; then
  printf "\n"
  printf "\033[1;33m[!] PYLOVARA-SYSTEM : SHELL UPDATE VERFÜGBAR !\033[0m\n"
  printf "    Lokaler Stand : %s\n" "$PV_LOCAL"
  printf "    Remote Stand  : %s\n" "$PV_REMOTE_SHA"
  printf "    FÜR EIN UPDATE NUTZE : SHELLUPDATE .\n"
  printf "\n"
else
  printf "\n"
  printf "\033[1;33m[*] PYLOVARA-SYSTEM : SHELL IST AKTUELL .\033[0m\n"
  printf "\n"
fi