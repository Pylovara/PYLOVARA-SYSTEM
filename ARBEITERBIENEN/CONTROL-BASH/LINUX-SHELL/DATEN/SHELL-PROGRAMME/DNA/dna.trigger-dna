#!/bin/bash
# ==============================================================================
# kernel.cut-dna [0.4]
# ==============================================================================
# Ort   : /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/DNA/dna.trigger-dna
# Zweck : dna trigger für cmd befehle, beta.
# Status: test bereich
# TERMINAL : dna <cmd>
# ==============================================================================

export PV_COLOR_RESET='\e[0m'
export PV_COLOR_CMD_SUCCESS='\e[38;5;82m'  # Grün
export PV_COLOR_CMD_ERROR='\e[38;5;196m'   # Rot
# dna.trigger-dna – Der zentrale DNA-Dispatcher (einmalig)

DNA() {
    local cmd="$1"
    shift

    # Pfad zum .dna-cmd-Modul
    local dnafile="/PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/CMD/${cmd}.dna-cmd"

    if [[ -f "$dnafile" ]]; then
        source "$dnafile"
        DNA_EXEC "$@"
    else
        echo "❌ Befehl '$cmd' unbekannt."
        echo "[AI] fragen? Alternativ -> dna info dna lex"
        ki2 --prompt "Welche möglichen Befehle könnten dem Nutzer vorschweben, wenn er '$cmd' eingegeben hat?"
    fi
}

export -f DNA
