#!/bin/bash
# ==============================================================================
# dna.shell-dna [0.3]
# ==============================================================================
# Ort   : /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/DNA/DNA.shell-dna
# Zweck : prototyp version .
# Status: instabil
# TERMINAL : dna <cmd>
