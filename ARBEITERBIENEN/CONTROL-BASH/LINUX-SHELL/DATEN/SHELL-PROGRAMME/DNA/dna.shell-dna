# dna.shell-dna – Benutzereingabe für DNA-CMDs

if ! declare -f DNA > /dev/null; then
    source "/PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/DNA/dna.trigger-dna"
fi

if [[ -z "$1" ]]; then
    echo "❌ Nutzung: DNA <befehl>"
    exit 1
fi

# Führe Befehl aus
DNA "$@"
