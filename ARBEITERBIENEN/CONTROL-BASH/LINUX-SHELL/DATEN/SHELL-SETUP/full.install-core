#!/bin/bash
# v0.4.2
# Pylovara Root-Installer
# führe aus mit: sudo ./full.install-core
# Quelle : /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/SETUP/INSTALL/full.install-core

set -e

## KONFIGURATION 
PV_DIR="/PYLOVARA-SYSTEM"
REPO_URL="https://github.com/Pylovara/PYLOVARA-SYSTEM.git"
WRAPPER_NAME="pylovara.wrapper-shell"
WRAPPER_SOURCE="$PV_DIR/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/SETUP/INSTALL/usr/bin/$WRAPPER_NAME"
WRAPPER_TARGET="/usr/local/bin/pylovara"
CONTROL_CONF="$PV_DIR/ARBEITERBIENEN/CONTROL-BASH/CONTROL.PV-CONF"

## FUNKTIONEN 
log_info() { echo "ℹ️  $1"; }
log_ok()   { echo "✅ $1"; }
log_warn() { echo "⚠️  $1"; }
log_err()  { echo "❌ $1"; }

## 1. ROOT-PRÜFUNG
if [ "$EUID" -ne 0 ]; then
  log_err "Dieses Skript muss als root laufen."
  log_info "Führe aus mit: sudo $0"
  exit 1
fi

## 2. REPO ANLEGEN
# Erst aus dem Baum wechseln. Startet man das Skript aus /PYLOVARA-SYSTEM,
# löscht rm -rf das Arbeitsverzeichnis von git. Der Klon bricht dann ab,
# bevor der Ordner neu existiert.
cd / || {
  log_err "Konnte nicht nach / wechseln."
  exit 1
}

if ! command -v git >/dev/null 2>&1; then
  log_err "git ist nicht installiert."
  log_info "Installiere git und starte das Skript erneut."
  exit 1
fi

REAL_USER="${SUDO_USER:-}"
if [ -z "$REAL_USER" ]; then
  REAL_USER="$(logname 2>/dev/null || true)"
fi

if [ -d "$PV_DIR" ]; then
  log_warn "Alte Installation gefunden. Entferne..."
  rm -rf "$PV_DIR"
elif [ -e "$PV_DIR" ]; then
  log_err "$PV_DIR existiert bereits und ist kein Verzeichnis."
  exit 1
else
  log_info "Frische Installation."
fi

umask 022
log_info "Lege $PV_DIR an und klone das Repository..."
git clone "$REPO_URL" "$PV_DIR"
log_ok "Repository geklont: $PV_DIR"

if [ -n "$REAL_USER" ]; then
  chown -R "$REAL_USER:" "$PV_DIR"
  log_ok "Besitz von $PV_DIR auf $REAL_USER gesetzt."
fi

## 3. WRAPPER PRÜFEN
if [ ! -f "$WRAPPER_SOURCE" ]; then
  log_err "Wrapper nicht gefunden: $WRAPPER_SOURCE"
  log_info "Prüfe den Pfad: ls -la $PV_DIR/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/SETUP/INSTALL/usr/bin/"
  exit 1
fi
log_ok "Wrapper gefunden: $WRAPPER_SOURCE"

## 4. WRAPPER NACH /usr/local/bin KOPIEREN
log_info "Kopiere Wrapper nach $WRAPPER_TARGET..."
cp "$WRAPPER_SOURCE" "$WRAPPER_TARGET"
chmod +x "$WRAPPER_TARGET"
log_ok "Wrapper installiert: $WRAPPER_TARGET"

## 5. IN /etc/shells EINTRAGEN
if ! grep -Fxq "$WRAPPER_TARGET" /etc/shells; then
  log_info "Trage $WRAPPER_TARGET in /etc/shells ein..."
  echo "$WRAPPER_TARGET" >> /etc/shells
  log_ok "Eingetragen."
else
  log_info "$WRAPPER_TARGET ist bereits in /etc/shells."
fi

## 6. STANDARD-SHELL SETZEN 
if [ -z "$REAL_USER" ]; then
  log_warn "Konnte echten Nutzer nicht ermitteln."
  log_info "Setze Shell manuell: chsh -s $WRAPPER_TARGET <nutzer>"
else
  log_info "Setze Shell für $REAL_USER auf $WRAPPER_TARGET..."
  chsh -s "$WRAPPER_TARGET" "$REAL_USER" || {
    log_warn "chsh fehlgeschlagen. Manuell: chsh -s $WRAPPER_TARGET $REAL_USER"
  }
fi

## 7. CONTROL.PV-CONF IN .bashrc/.zshrc EINBINDEN
USER_HOME=$(eval echo "~$REAL_USER")
if [ -f "$CONTROL_CONF" ]; then
  for RC in "$USER_HOME/.bashrc" "$USER_HOME/.zshrc"; do
    if [ -f "$RC" ]; then
      if ! grep -q "source $CONTROL_CONF" "$RC"; then
        log_info "Ergänze source-Zeile in $RC..."
        echo "source $CONTROL_CONF" >> "$RC"
        log_ok "Ergänzt."
      else
        log_info "source-Zeile existiert bereits in $RC."
      fi
    fi
  done
else
  log_warn "control.pv-conf nicht gefunden: $CONTROL_CONF"
  log_info "Prüfe den Pfad: ls -la $PV_DIR/ARBEITERBIENEN/CONTROL-BASH/"
fi

## 8. ABSCHLUSS
echo ""
log_ok "PYLOVARA LINUX SHELL erfolgreich installiert."
echo ""
log_info "Bitte neu anmelden oder Shell neu starten:"
echo "  exec $WRAPPER_TARGET"
echo ""
log_info "Oder: source $CONTROL_CONF"