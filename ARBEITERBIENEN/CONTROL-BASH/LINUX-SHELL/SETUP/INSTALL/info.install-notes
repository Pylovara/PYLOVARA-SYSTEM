 SO ABGESTELLT WERDEN :

sudo nano /etc/pacman.conf
 
 DANN SUCHT IHR DIE STELLE : 

# Pacman won't upgrade packages listed in IgnorePkg and members of IgnoreGroup
IgnorePkg = 
#IgnoreGroup =

UND SCHREIBT IN IgnorePkG DANN FOLGENDES REIN : 

 hyprland hyprutils aquamarine hyprland-qtutils

