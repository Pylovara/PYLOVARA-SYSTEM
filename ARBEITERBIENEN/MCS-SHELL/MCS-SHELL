###====================================|====================================###
### X11
###====================================|====================================###

mcs_x11_find_window() {
    mcs_have xdotool || return 1
    xdotool search --class "$MCS_SHELL_CLASS" 2>/dev/null | head -n1
}

mcs_x11_visible() {
    mcs_have xdotool || return 1
    xdotool search --onlyvisible --class "$MCS_SHELL_CLASS" 2>/dev/null | grep -Fxq "$1"
}

mcs_x11_geometry() {
    local g wh rest x y w h
    g=$(xrandr --current 2>/dev/null | awk '/ connected/ { for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) { print $i; exit } }')
    [ -n "$g" ] || g=$(xdotool getdisplaygeometry 2>/dev/null | awk '{print $1"x"$2"+0+0"}')
    [ -n "$g" ] || return 1
    case "$g" in *+*+*) ;; *) g="${g}+0+0" ;; esac
    wh=${g%%+*}; rest=${g#*+}; x=${rest%%+*}; rest=${rest#*+}; y=${rest%%+*}
    w=${wh%x*}; h=${wh#*x}
    w=$(( w * MCS_SHELL_WIDTH_PERCENT / 100 ))
    h=$(( h * MCS_SHELL_HEIGHT_PERCENT / 100 ))
    x=$(( x + (${wh%x*} - w) / 2 ))
    y=$(( y + (${wh#*x} * MCS_SHELL_TOP_PERCENT / 100) ))
    printf '%s %s %s %s\n' "$x" "$y" "$w" "$h"
}

mcs_x11_apply_geometry() {
    local win="$1" geo x y w h
    geo=$(mcs_x11_geometry 2>/dev/null) || return 0
    read -r x y w h <<< "$geo"
    if mcs_have xdotool; then
        xdotool windowsize "$win" "$w" "$h" >/dev/null 2>&1 || true
        xdotool windowmove "$win" "$x" "$y" >/dev/null 2>&1 || true
    elif mcs_have wmctrl; then
        wmctrl -i -r "$win" -e "0,$x,$y,$w,$h" >/dev/null 2>&1 || true
    fi
}

mcs_x11_launch_postprocess() {
    [ "${MCS_SHELL_X11_GEOMETRY:-1}" = "1" ] || return 0
    [ -n "${DISPLAY:-}" ] || return 0
    mcs_have xdotool || mcs_have wmctrl || return 0
    (
        local i win
        for ((i=0; i<30; i++)); do
            win=$(mcs_x11_find_window)
            if [ -n "$win" ]; then
                mcs_x11_apply_geometry "$win"
                break
            fi
            sleep 0.1
        done
    ) >/dev/null 2>&1 &
}

mcs_x11_toggle() {
    local win
    win=$(mcs_x11_find_window)
    if [ -n "$win" ]; then
        if mcs_x11_visible "$win"; then
            xdotool windowminimize "$win" >/dev/null 2>&1 || true
        else
            xdotool windowmap "$win" >/dev/null 2>&1 || true
            xdotool windowactivate "$win" >/dev/null 2>&1 || true
            mcs_x11_apply_geometry "$win"
        fi
        return 0
    fi
    mcs_build_command || return 1
    mcs_run_command
    mcs_x11_launch_postprocess
}

mcs_x11_focus() {
    local win
    win=$(wmctrl -lx 2>/dev/null | awk -v c="$MCS_SHELL_CLASS" 'tolower($3) ~ tolower(c) {print $1; exit}')
    if [ -n "$win" ]; then
        wmctrl -i -a "$win" >/dev/null 2>&1 || true
        return 0
    fi
    mcs_build_command || return 1
    mcs_run_command
    mcs_x11_launch_postprocess
}

###====================================|====================================###
### AKTIONEN
###====================================|====================================###

mcs_toggle_mode() {
    [ "${MCS_SHELL_TOGGLE:-1}" = "1" ] || { printf 'none'; return; }
    if mcs_is_hyprland; then printf 'hyprland'; return; fi
    if mcs_is_sway; then printf 'sway'; return; fi
    if mcs_is_i3; then printf 'i3'; return; fi
    if [ -n "${DISPLAY:-}" ] && mcs_have xdotool; then printf 'x11'; return; fi
    if [ -n "${DISPLAY:-}" ] && mcs_have wmctrl; then printf 'x11-focus'; return; fi
    printf 'none'
}

mcs_launch() {
    if mcs_is_hyprland; then
        mcs_hypr_launch_normal
    elif mcs_is_sway; then
        mcs_sway_launch_normal
    elif mcs_is_i3; then
        mcs_i3_launch_normal
    else
        mcs_build_command || return 1
        mcs_run_command
        mcs_x11_launch_postprocess
    fi
}

mcs_do_toggle() {
    case "$(mcs_toggle_mode)" in
        hyprland) mcs_hypr_toggle ;;
        sway) mcs_sway_toggle ;;
        i3) mcs_i3_toggle ;;
        x11) mcs_x11_toggle ;;
        x11-focus) mcs_x11_focus ;;
        *) return 1 ;;
    esac
}

###====================================|====================================###
### AUSGABE / HILFE
###====================================|====================================###

mcs_usage() {
    cat <<EOF
MCS-SHELL ${MCS_SHELL_VERSION} - Pylovara Terminal (Bash/Zsh)

Nutzung:
  mcs-shell [--toggle|--new] [--shell NAME] [--backend NAME]
  mcs-shell --check
  mcs-shell --print-command
  mcs-shell -- COMMAND [ARG...]

Optionen:
  --toggle        Dropdown zeigen/verstecken (Standard)
  --new           neues Fenster oeffnen
  --shell NAME    bash | zsh | /absoluter/pfad
  --backend NAME  kitty | foot | alacritty | wezterm | konsole | ...
  --cwd PFAD      Arbeitsverzeichnis fuer den Start
  --check         Umgebung, Backend und Shell pruefen
  --print-command Startkommando ausgeben, nicht starten
  -h, --help      diese Hilfe
  -V, --version   Version

Start nach Installation: Super+Shift+Enter
Konfiguration: ${MCS_SHELL_CONFIG}
EOF
}

mcs_print_missing_backend() {
    local id
    id=$(awk -F= '/^ID=/{gsub(/"/,"",$2); print $2; exit}' /etc/os-release 2>/dev/null)
    mcs_warn "Kein Terminal-Backend gefunden."
    printf '\nInstallationshinweise:\n' >&2
    case "$id" in
        arch) printf '  sudo pacman -S --needed kitty jq\n' >&2 ;;
        debian|ubuntu) printf '  sudo apt install kitty jq\n' >&2 ;;
        fedora) printf '  sudo dnf install kitty jq\n' >&2 ;;
        opensuse*|suse) printf '  sudo zypper install kitty jq\n' >&2 ;;
        *) printf '  Installiere kitty und jq mit deinem Paketmanager.\n' >&2 ;;
    esac
    printf '  Alternativ: MCS_SHELL_BACKEND=foot|alacritty|xterm\n\n' >&2
}

mcs_print_check() {
    printf 'MCS-SHELL %s\n' "$MCS_SHELL_VERSION"
    printf 'Home:     %s\n' "$MCS_SHELL_HOME"
    printf 'Config:   %s\n' "$MCS_SHELL_CONFIG"
    printf 'Session:  %s (%s)\n' "$(mcs_session_name)" "${XDG_SESSION_TYPE:-?}"
    printf 'Display:  WAYLAND_DISPLAY=%s DISPLAY=%s\n' "${WAYLAND_DISPLAY:-}" "${DISPLAY:-}"
    printf 'Backend:  %s %s\n' "${MCS_BACKEND:-keins}" "$( [ -n "${MCS_BACKEND:-}" ] && mcs_path_of "$MCS_BACKEND" )"
    printf 'Shell:    %s %s\n' "${MCS_LOGIN_SHELL:-keine}" "$( [ "${MCS_SHELL_LOGIN:-1}" = "1" ] && printf '(login)' )"
    printf 'Toggle:   %s\n' "$(mcs_toggle_mode)"
    printf 'Special:  special:%s\n' "$MCS_SHELL_HYPR_SPECIAL"
    printf 'jq:       %s\n' "$(mcs_path_of jq || printf '-')"
    printf 'Source:   %s\n' "$( [ -r "$MCS_SHELL_HOME/MCS-SHELL.SOURCE" ] && printf 'ok' || printf 'fehlt' )"
    if [ "${MCS_BACKEND:-}" = "kitty" ]; then
        printf 'Kitty:    %s\n' "$(kitty --version 2>/dev/null | head -n1)"
    fi
}

###====================================|====================================###
### MAIN
###====================================|====================================###

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) mcs_usage; exit 0 ;;
        -V|--version) printf 'MCS-SHELL %s\n' "$MCS_SHELL_VERSION"; exit 0 ;;
        --check) ACTION="check"; shift ;;
        --toggle) ACTION="toggle"; shift ;;
        --new|--open) ACTION="new"; shift ;;
        --print-command|--dry-run) DRY_RUN=1; shift ;;
        --shell)
            [ "$#" -ge 2 ] || mcs_die "--shell braucht einen Wert."
            MCS_SHELL_SHELL="$2"; shift 2 ;;
        --backend)
            [ "$#" -ge 2 ] || mcs_die "--backend braucht einen Wert."
            MCS_SHELL_BACKEND="$2"; shift 2 ;;
        --cwd)
            [ "$#" -ge 2 ] || mcs_die "--cwd braucht einen Wert."
            MCS_SHELL_CWD="$2"; shift 2 ;;
        --)
            shift; PASSTHROUGH=("$@"); break ;;
        -*)
            mcs_die "Unbekannte Option: $1 (siehe --help)" ;;
        *)
            PASSTHROUGH=("$@"); break ;;
    esac
done

if [ -n "${MCS_SHELL_CWD:-}" ]; then
    cd -- "$MCS_SHELL_CWD" || mcs_die "Verzeichnis nicht gefunden: $MCS_SHELL_CWD"
fi

if [ "$ACTION" = "check" ]; then
    mcs_resolve_backend || true
    mcs_resolve_shell || true
    mcs_print_check
    [ -n "${MCS_BACKEND:-}" ] && exit 0 || exit 1
fi

if ! mcs_resolve_backend; then
    mcs_print_missing_backend
    exit 1
fi

if [ "${#PASSTHROUGH[@]}" -eq 0 ]; then
    mcs_resolve_shell || exit 1
    mcs_set_shell_args
else
    MCS_SHELL_ARGS=("${PASSTHROUGH[@]}")
fi

if [ "$DRY_RUN" = "1" ]; then
    mcs_build_launch_string || exit 1
    printf '\n'
    exit 0
fi

case "$ACTION" in
    new)
        mcs_launch
        ;;
    toggle)
        if ! mcs_do_toggle; then
            mcs_launch
        fi
        ;;
esac

