c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <time.h>

#define REPO_PATH "/PYLOVARA-SYSTEM"
#define TIMESTAMP_FILE "/PYLOVARA-SYSTEM/.last_check"
#define TWO_DAYS_IN_SECONDS (2 * 24 * 60 * 60)

// Funktion, um zu prüfen, ob 2 Tage vergangen sind
int oder_zwei_tage_vergangen() {
    struct stat attr;
    if (stat(TIMESTAMP_FILE, &attr) != 0) {
        // Datei existiert nicht -> Erster Lauf oder gelöscht -> Prüfen!
        return 1;
    }
    
    time_t jetzt = time(NULL);
    if ((jetzt - attr.st_mtime) >= TWO_DAYS_IN_SECONDS) {
        return 1;
    }
    return 0;
}

// Zeitstempel aktualisieren (aktualisiert das Änderungsdatum der Datei)
void update_timestamp() {
    FILE *f = fopen(TIMESTAMP_FILE, "w");
    if (f) {
        fprintf(f, "%ld\n", (long)time(NULL));
        fclose(f);
    }
}

int main() {
    // Falls noch keine 2 Tage rum sind, brechen wir lautlos ab
    if (!oder_zwei_tage_vergangen()) {
        return 0;
    }

    // 1. Lokalen Commit-Hash holen
    char cmd_local[512];
    snprintf(cmd_local, sizeof(cmd_local), "git -C %s rev-parse HEAD 2>/dev/null", REPO_PATH);
    FILE *fp_local = popen(cmd_local, "r");
    char local_sha[64] = {0};
    if (fp_local) {
        if (fgets(local_sha, sizeof(local_sha), fp_local)) {
            local_sha[strcspn(local_sha, "\n")] = 0; // Zeilenumbruch entfernen
        }
        pclose(fp_local);
    }

    // Falls kein Git-Verzeichnis gefunden wurde
    if (strlen(local_sha) == 0) {
        return 0; 
    }

    // 2. Remote Commit-Hash von GitHub holen (ohne das ganze Repo zu laden)
    char remote_sha[64] = {0};
    FILE *fp_remote = popen("git ls-remote https://github.com HEAD 2>/dev/null", "r");
    if (fp_remote) {
        char line[256];
        if (fgets(line, sizeof(line), fp_remote)) {
            // ls-remote liefert: "HASH\trefs/heads/main" -> wir schneiden den Hash ab
            sscanf(line, "%63s", remote_sha);
        }
        pclose(fp_remote);
    }

    // Zeitstempel erneuern, da die Netzwerkabfrage jetzt stattfand
    update_timestamp();

    // 3. Abgleich & Ausgabe für den User
    if (strlen(remote_sha) > 0 && strcmp(local_sha, remote_sha) != 0) {
        printf("\n\033[1;33m[!] PYLOVARA-SYSTEM: Shell Update Verfügbar!\033[0m\n");
        printf("    Für ein Update gebe \033[1;32mSHELLUPDATE\033[0m ein.\n\n");
    } else {
        printf("\n\033[1;32m[*] PYLOVARA-SYSTEM: Shell Aktuell.\033[0m\n\n");
    }

    return 0;
}