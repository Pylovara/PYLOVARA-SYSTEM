Daten:      mov movzx movsx lea xchg
Rechnen:    add sub adc sbb and or xor not neg cmp test
            shl shr sar imul idiv
Stack:      push pop
Kontrolle:  jmp jcc call ret
System:     syscall sysret iretq cli sti hlt
MSR:        rdmsr wrmsr swapgs rdgsbase wrgsbase
Kontroll:   mov cr0..cr8, mov dr0..dr7
Tabellen:   lgdt lidt ltr lldt
TLB:        invlpg invpcid
Atomar:     lock cmpxchg, lock xadd
Barrieren:  mfence lfence sfence
Info:       cpuid rdtsc rdtscp
Kontext:    fxsave fxrstor xsave xrstor xgetbv
I/O:        in out
Cache:      clflush wbinvd invd


