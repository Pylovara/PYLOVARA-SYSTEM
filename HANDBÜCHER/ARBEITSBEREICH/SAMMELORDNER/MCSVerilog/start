#!/usr/bin/env bash
set -Eeuo pipefail

# Projektpfade relativ zu diesem Skript bestimmen
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
KERN="$ROOT/Kernprozesse"
PROTEINE="$ROOT/Proteine"

SIM="$KERN/mcs_sim.out"
VCD="$KERN/mcs_sim.vcd"

echo "MCS-Verilog: Initialisierung"
echo "Projekt: $ROOT"

# Werkzeuge prüfen
for tool in iverilog vvp; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "FEHLER: '$tool' wurde nicht gefunden." >&2
        exit 1
    fi
done

# Eingabedateien prüfen
for file in \
    "$KERN/mcs_sim.v" \
    "$KERN/mcs_sim_tb.v" \
    "$PROTEINE/mcs_protein.v"
do
    if [[ ! -f "$file" ]]; then
        echo "FEHLER: Quelldatei fehlt: $file" >&2
        exit 1
    fi
done

# Im Kernprozess-Verzeichnis arbeiten, damit relative VCD-Pfade stimmen
cd "$KERN"

echo
echo "1/3: Verilog kompilieren"

iverilog -g2012 \
    -o "$SIM" \
    "$KERN/mcs_sim.v" \
    "$KERN/mcs_sim_tb.v" \
    "$PROTEINE/mcs_protein.v"

echo
echo "2/3: Simulation ausführen"

vvp "$SIM"

if [[ ! -f "$VCD" ]]; then
    echo "HINWEIS: Die VCD-Datei wurde nicht unter $VCD gefunden."
    echo "Prüfe den $dumpfile-Pfad in mcs_sim.v und mcs_sim_tb.v."
else
    echo "VCD-Datei vorhanden: $VCD"
fi

echo
echo "3/3: Wellenform öffnen"

if command -v gtkwave >/dev/null 2>&1; then
    if [[ -f "$VCD" ]]; then
        gtkwave "$VCD"
    else
        echo "GTKWave wird übersprungen: VCD-Datei fehlt."
    fi
else
    echo "GTKWave ist nicht installiert oder nicht im PATH."
    echo "Die Simulation ist davon unabhängig."
    echo "VCD-Datei: $VCD"
fi

echo
echo "MCS-Verilog: Ablauf beendet"
