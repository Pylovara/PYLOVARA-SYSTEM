:!/usr/bin/env bash
set -euo pipefail

README="README.md"
TEMP_FILE="mcs_stats_gen.tmp"

echo "=== MCS-SYSTEM METrik-GENERATOR ==="

# Zählung initialisieren
CORE_FILES=0; CORE_LINES=0
NODE_FILES=0; NODE_LINES=0
NANO_FILES=0; NANO_LINES=0
MICRO_FILES=0; MICRO_LINES=0
NEEDLES_FILES=0; NEEDLES_LINES=0

# Funktion zum Zählen von Zeilen und Dateien
calc_stats() {
    local ext="$1"
    local files=0
    local lines=0
    
    while IFS= read -r file; do
        if [ -f "$file" ]; then
            files=$((files + 1))
            local l
            l=$(wc -l < "$file" 2>/dev/null || echo 0)
            lines=$((lines + l))
        fi
    done < <(find . -name "*.$ext" -not -path "*/.*")
    
    echo "$files $lines"
}

# Werte einlesen
read CORE_FILES CORE_LINES <<< $(calc_stats "CORE")
read NODE_FILES NODE_LINES <<< $(calc_stats "NODE")
read NANO_FILES NANO_LINES <<< $(calc_stats "NANO")
read MICRO_FILES MICRO_LINES <<< $(calc_stats "MICRO")
read NEEDLES_FILES NEEDLES_LINES <<< $(calc_stats "NEEDLES")

TOTAL_FILES=$((CORE_FILES + NODE_FILES + NANO_FILES + MICRO_FILES + NEEDLES_FILES))
TOTAL_LINES=$((CORE_LINES + NODE_LINES + NANO_LINES + MICRO_LINES + NEEDLES_LINES))

echo "Gefunden: $TOTAL_FILES Dateien, $TOTAL_LINES Zeilen Code."

# Markdown-Block für die README generieren
cat << EOF > "$TEMP_FILE"
### 🧬 MCS-SYSTEM ARCHITEKTUR-STATUS (AUTOMATISIERT)

\`\`\`text
[ TWS RUNTIME STATUS: AKTIV | KERNEL: 00-83 ]
--------------------------------------------------
 ┣ 📂 .CORE    : $CORE_FILES Datei(en)  | $CORE_LINES Zeilen
 ┣ 📂 .NODE    : $NODE_FILES Datei(en)  | $NODE_LINES Zeilen
 ┣ 📂 .NANO    : $NANO_FILES Datei(en)  | $NANO_LINES Zeilen
 ┣ 📂 .MICRO   : $MICRO_FILES Datei(en)  | $MICRO_LINES Zeilen
 ┗ 📂 .NEEDLES : $NEEDLES_FILES Datei(en) | $NEEDLES_LINES Zeilen
--------------------------------------------------
 GESAMT-SUBSTANZ : $TOTAL_FILES Module / $TOTAL_LINES Codezeilen
\`\`\`
*Letzte Synchronisation durch MCS-Bash-Meter: $(date -u '+%Y-%m-%d %H:%M:%S UTC')*
EOF

# In die README.md einfügen (zwischen festen Markern)
if grep -q "<!-- MCS-STATS:START -->" "$README"; then
    # Python oder sed nutzen, um den Bereich zwischen den Markern zu ersetzen
    python3 -c "
with open('$README', 'r') as f:
    content = f.read()
with open('$TEMP_FILE', 'r') as f:
    stats = f.read()

start_tag = '<!-- MCS-STATS:START -->'
end_tag = '<!-- MCS-STATS:END -->'

if start_tag in content and end_tag in content:
    pre = content.split(start_tag)[0]
    post = content.split(end_tag)[1]
    new_content = pre + start_tag + '\n' + stats + '\n' + end_tag + post
    with open('$README', 'w') as f:
        f.write(new_content)
"
    echo "[✓] README.md erfolgreich aktualisiert."
else
    echo "[!] Marker <!-- MCS-STATS:START --> nicht in README.md gefunden!"
fi

rm -f "$TEMP_FILE"